# Copy this file to ".env" and fill in your values.

# --- Choose your LLM provider -------------------------------------------
# One of: anthropic | groq | gemini | openrouter | ollama
LLM_PROVIDER=gemini

# --- API key for whichever provider you picked above ---------------------
# Only the one matching LLM_PROVIDER is actually needed.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Ollama needs no key — just run `ollama serve` and `ollama pull llama3.2`.

# --- Optional: override the default model for your chosen provider -------
# GROQ_MODEL=
# GEMINI_MODEL=
# OPENROUTER_MODEL=
# OLLAMA_MODEL=llama3.2

# --- Organization name shown in the UI and used in the assistant prompt --
ORG_NAME=ABC Motors Group
